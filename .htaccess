RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# Domaine sans www -> www
RewriteCond %{HTTP_HOST} ^larenovationdevosreves\.com$ [NC]
RewriteRule ^(.*)$ https://www.larenovationdevosreves.com/$1 [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
# Pendant la phase de corrections fréquentes sur o2switch (PowerBoost), décommenter :
# <IfModule LiteSpeed>
#   CacheDisable public /
# </IfModule>

# Fichiers de configuration et de sauvegarde : jamais servis par le web
<FilesMatch "^(agence_|leads_).*\.(json|csv)$">
  Require all denied
</FilesMatch>

# Fichiers du dépôt qui ne doivent pas être servis
<FilesMatch "^(build\.py|README\.md|\.nojekyll)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
